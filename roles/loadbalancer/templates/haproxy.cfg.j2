global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend http_front
    bind *:80
    # Al het verkeer wordt naar de K3s cluster backend gestuurd
    default_backend k3s_workers

backend k3s_workers
    balance roundrobin
    # Stuur het verkeer naar de Traefik Ingress (poort 80) van je worker nodes
    server k8s-worker-01 192.168.15.134:80 check
    server k8s-worker-02 192.168.15.135:80 check

listen stats
    bind *:8404
    stats enable
    stats uri /stats
    stats refresh 2s
    stats show-node
